# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# .next ของแอปเดิม เก็บไว้กู้โค้ด (source maps) ไม่ต้องขึ้น git
.recovery-old-app/

# ไบต์โค้ดของสคริปต์ใน skill — สร้างใหม่ได้เอง ไม่ต้องขึ้น git
__pycache__/
*.pyc
