# Supabase — เอาจาก Dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ตัวแอปใช้ transaction pooler (port 6543) — Dashboard > Connect > Transaction pooler
# serverless เปิด connection ถี่ ต้องใช้ pooler ตัวนี้เท่านั้น
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# migration ใช้ session pooler (port 5432) — Dashboard > Connect > Session pooler
# ต่างกันแค่ port แต่จำเป็น: transaction pooler รัน DDL ยาว ๆ ไม่จบ
DIRECT_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
