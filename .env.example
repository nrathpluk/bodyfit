# Supabase — เอาจาก Dashboard > Project Settings > Data API / Database
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# connection string ของ transaction pooler (port 6543) — Dashboard > Connect > ORMs
# ต้องมี ?pgbouncer=true และห้ามใช้ port 5432 บน serverless
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
